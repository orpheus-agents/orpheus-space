ORPHEUS_BROWSER_AUTH=anonymous
ORPHEUS_PUBLIC_URL=http://localhost:8010
PUBLIC_API_KEYS=["local-space-key"]
ORPHEUS_HOST=0.0.0.0
ORPHEUS_PORT=8000
ORPHEUS_SYSTEM_HOST=0.0.0.0
ORPHEUS_SYSTEM_PORT=9100
HARNESS_ENV_ALLOWLIST=["MATTERMOST_BOT_TOKEN","HELPDESK_API_KEY"]
MAX_REQUEST_BYTES=1048576
# Set these for the explicit result endpoint and make start-worker.
ORPHEUS_BASE_URL=
ORPHEUS_API_KEY=
WORKER_POLL_SECONDS=1

# SAML (serve only): set ORPHEUS_BROWSER_AUTH=saml and an HTTPS public origin.
SAML_SP_ENTITY_ID=
SAML_IDP_METADATA_FILE=
SAML_SP_CERT_FILE=
SAML_SP_KEY_FILE=
BROWSER_SESSION_TTL_SECONDS=43200
